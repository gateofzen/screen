{
  "name": "曲名リモコン（FEELCYCLE Visualizer）",
  "short_name": "曲名リモコン",
  "description": "Shazam で認識した曲を FEELCYCLE Visualizer の画面に表示する",
  "start_url": "share.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0b10",
  "theme_color": "#0b0b10",
  "icons": [
    { "src": "np-icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "np-icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "np-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "share.html",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
